# Copy to .env (never commit .env). Needed so the access token refreshes itself.
FB_APP_ID=
FB_APP_SECRET=

# Optional: ElevenLabs voice (set render.tts: elevenlabs in config.yaml).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional: Pixabay picture search for `philoreels fetch-images` (free key at pixabay.com/api/docs).
PIXABAY_API_KEY=
